# 本地私有配置模板 —— 复制成 application-local.yml 后填入真实值。
# application-local.yml 已被 .gitignore 排除,不会进版本库;application.yml 里用
# `optional:classpath:application-local.yml` 可选加载它,文件不存在也不会报错。
#
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#
# 也可以不用这个文件,改设环境变量(优先级更高):DB_URL / DB_USERNAME / DB_PASSWORD / JWT_SECRET

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/wedding?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: root
    # ⚠️ 密码必须加引号:YAML 会把纯数字当八进制/整数解析(如 041222 → 17042),连不上还不告诉你原因
    password: "your-mysql-password"

app:
  jwt:
    # HS256 签名密钥,至少 32 字节。换一串只有你知道的随机字符串,例如:
    #   openssl rand -base64 48
    secret: "change-me-to-a-random-string-at-least-32-bytes-long"
